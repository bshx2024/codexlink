{
  "manifest_version": 3,
  "name": "ComLinkAI",
  "version": "2.0.0",
  "description": "AI 浏览器自动化操控中转 & 博客评论反链智能助手 & 网页剪藏",
  "permissions": [
    "activeTab",
    "tabs",
    "tabGroups",
    "scripting",
    "sidePanel",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ComLinkAI 侧边栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
